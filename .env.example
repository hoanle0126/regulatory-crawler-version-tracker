# Environment Configuration for RegTracker

NODE_ENV=development
COMPOSE_PROJECT_NAME=regtracker

# Database (PostgreSQL isolated port 55432)
DATABASE_URL="postgresql://regtracker:regtracker_secret@localhost:55432/regtracker_db?schema=public"

# Redis Cache & BullMQ Queue (isolated port 6381)
REDIS_URL="redis://localhost:6381"

# Backend API Configuration
PORT=4101
API_URL="http://localhost:4101"
JWT_SECRET="regtracker-super-secure-production-ready-jwt-secret-key-2026"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="regtracker-refresh-token-secret-key-2026"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend Configuration
WEB_PORT=3101
WEB_URL="http://localhost:3101"
NEXT_PUBLIC_API_URL="http://localhost:4101/api"

# Demo Source Server (Port 5101)
DEMO_SOURCE_PORT=5101
DEMO_SOURCE_URL="http://localhost:5101"

# Crawler Safety & SSRF Configuration
CRAWLER_USER_AGENT="RegTracker-Bot/1.0 (+https://regtracker.local/bot; compliance-monitoring)"
CRAWLER_MAX_RESPONSE_SIZE=10485760 # 10MB limit
CRAWLER_TIMEOUT=15000 # 15 seconds
CRAWLER_MAX_REDIRECTS=5
ALLOW_LOCAL_DEMO_SOURCES=true # Allows crawling the mock demo server on localhost:5101 in dev/test only

# Webhook Security
WEBHOOK_SIGNING_SECRET="regtracker_default_webhook_hmac_secret_key"
WEBHOOK_MAX_RETRIES=3

# Optional AI Summary Provider (Core system works 100% deterministically without LLM)
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# GEMINI_API_KEY=
